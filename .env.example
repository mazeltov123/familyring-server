# ============================================================
# FamilyRing Server — Environment Variables
# Copy this to .env and fill in your values
# On Railway/Render, add these as environment variables
# ============================================================

# Your Telnyx API Key (portal.telnyx.com → API Keys)
TELNYX_API_KEY=KEY_your_api_key_here

# Your Telnyx phone number in E.164 format
TELNYX_FROM_NUMBER=+12125551234

# Your Telnyx SIP Connection ID (portal.telnyx.com → Connections → copy ID)
TELNYX_CONNECTION_ID=your_connection_id_here

# The public URL of THIS server after deployment
# Railway: https://familyring-production.up.railway.app
# Render:  https://familyring.onrender.com
SERVER_URL=https://your-app.railway.app

# PIN for the record-and-broadcast feature (press 3 on IVR)
BROADCAST_PIN=1234

# Port (Railway/Render set this automatically)
PORT=3000
